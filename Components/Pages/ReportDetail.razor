@page "/reporte/{Id:long}"
@inject NacoDatabase Db
@inject IJSRuntime JS
<div class="page-title no-print"><div><h1>Reporte de movimiento @Id</h1><p>Cuadro registrado y croquis histórico</p></div><button class="primary" @onclick="Print">Exportar PDF</button></div>
@if(busy){<p>Cargando…</p>}else if(header is not null){<div class="print-page report-cover"><h1>SISTEMA NACO · @header.Tipo</h1><div class="report-meta"><div><span>Movimiento</span><b>N.º @header.IdMovimiento</b></div><div><span>Fecha</span><b>@header.Fecha.ToString("dd/MM/yyyy HH:mm")</b></div><div><span>Referencia / contenedor</span><b>@header.Referencia</b></div><div><span>Usuario</span><b>@header.Usuario</b></div><div><span>Enviado a</span><b>@header.EnviadoA</b></div><div><span>@(header.Tipo=="INGRESO"?"Recibido por":"Entregado por")</span><b>@header.RecibidoPor</b></div></div>@if(!string.IsNullOrWhiteSpace(header.Observacion)){<p class="report-notes"><b>Observaciones:</b> @header.Observacion</p>}<h2>UBICACIONES MODIFICADAS</h2><div class="table-wrap change-table"><table><thead><tr><th>Acción</th><th>Ubicación afectada</th><th>Producto</th><th>Medida</th><th>Pallets</th><th>Cajas</th></tr></thead><tbody>@foreach(var change in Changes){<tr><td><b>@change.Action</b></td><td><b>@change.Location</b></td><td>@change.Product</td><td>@change.Measure</td><td>@change.Pallets</td><td>@change.Boxes.ToString("N0")</td></tr>}</tbody></table></div><h2>CUADRO DE PRODUCTOS</h2><div class="table-wrap"><table><thead><tr><th>Ubicación</th><th>@(header.Tipo=="INGRESO"?"Distribución":header.Tipo=="MOVIMIENTO"?"Destino":"Enviado a")</th><th>Producto</th><th>Medida</th><th>Pallets</th><th>Cajas/pallet</th><th>Adicionales</th><th>Faltantes</th><th>Total cajas</th></tr></thead><tbody>@foreach(var x in details){<tr><td>@x.Ubicacion</td><td>@(header.Tipo=="INGRESO"?x.Distribucion:header.Tipo=="MOVIMIENTO"?x.MovidoA:header.EnviadoA)</td><td>@x.Producto</td><td>@x.Medida</td><td>@x.Pallets</td><td>@x.CajasPorPallet</td><td>@x.Adicionales</td><td>@x.Faltantes</td><td>@x.TotalCajas</td></tr>}</tbody><tfoot><tr><th colspan="4">TOTALES</th><th>@details.Sum(x=>x.Pallets)</th><th></th><th>@details.Sum(x=>x.Adicionales)</th><th>@details.Sum(x=>x.Faltantes)</th><th>@details.Sum(x=>x.TotalCajas)</th></tr></tfoot></table></div></div><div class="print-page map-print-page"><h1>CROQUIS DEL MOVIMIENTO · PARTE 1</h1><WarehouseMap Items="plan" Sections="ABCD" Part="1" Actions="MapActions" /></div><div class="print-page map-print-page"><h1>CROQUIS DEL MOVIMIENTO · PARTE 2</h1><WarehouseMap Items="plan" Sections="ABCD" Part="2" Actions="MapActions" /></div>}
@if(!string.IsNullOrWhiteSpace(error)){<div class="alert error">@error</div>}
@code {[Parameter]public long Id{get;set;}private bool busy=true;private string error="";private MovementHeader? header;private List<OperationLine> details=[];private List<InventoryItem> plan=[];private List<MapAction> MapActions=>Changes.Select(x=>new MapAction(x.Location,x.Action,x.Action=="SE COLOCÓ",x.Pallets,x.Boxes)).ToList();private IEnumerable<ChangeRow> Changes{get{if(header is null)return[];var rows=new List<ChangeRow>();foreach(var x in details){if(header.Tipo=="INGRESO")rows.Add(new("SE COLOCÓ",x.Ubicacion,x.Producto,x.Medida,x.Pallets,x.TotalCajas));else if(header.Tipo=="MOVIMIENTO"){rows.Add(new("SE RETIRÓ",x.Ubicacion,x.Producto,x.Medida,x.Pallets,x.TotalCajas));rows.Add(new("SE COLOCÓ",x.MovidoA,x.Producto,x.Medida,x.Pallets,x.TotalCajas));}else rows.Add(new(header.Tipo=="SALIDA POR DAÑO"?"SE RETIRÓ POR DAÑO":"SE RETIRÓ",x.Ubicacion,x.Producto,x.Medida,x.Pallets,x.TotalCajas));}return rows;}}protected override async Task OnParametersSetAsync(){busy=true;error="";try{header=await Db.GetMovementHeaderAsync(Id);details=await Db.GetMovementDetailsAsync(Id);if(header.Tipo=="INGRESO")foreach(var line in details){if(string.IsNullOrWhiteSpace(line.Ubicacion))line.Ubicacion=line.MovidoA;}plan=await Db.GetHistoricalPlanAsync(Id);}catch(Exception ex){error=ex.Message;}finally{busy=false;}}private async Task Print()=>await JS.InvokeVoidAsync("print");private sealed record ChangeRow(string Action,string Location,string Product,string Measure,int Pallets,int Boxes);}

