@page "/croquis"
@inject NacoDatabase Db
@inject SessionState Session
@inject IJSRuntime JS

<div class="page-title no-print"><div><h1>Croquis del almacén</h1><p>Inventario consolidado y distribución por filas</p></div><div><button class="secondary" @onclick="Load">Actualizar</button> <button class="primary" @onclick="Print">Exportar PDF</button></div></div>
@if(!Session.IsAuthenticated){<div class="alert error">Inicie sesión para consultar el croquis.</div>}else if(busy){<p>Cargando croquis…</p>}else{
<div class="croquis-toolbar no-print"><label>Ubicación<input placeholder="Ej. A57" @bind="locationText" /></label><button class="secondary" @onclick="ApplyLocation">Ubicación</button><button class="secondary" @onclick="ShowAll">Todo</button><button class="@(mapPart==1?"primary":"secondary")" @onclick="()=>mapPart=1">Parte 1</button><button class="@(mapPart==2?"primary":"secondary")" @onclick="()=>mapPart=2">Parte 2</button><button class="secondary zoom-button" @onclick="ZoomOut">−</button><button class="primary zoom-button" @onclick="ZoomIn">+</button><button class="secondary" @onclick="ResetZoom">@($"{zoom:P0}")</button><span>Rueda: zoom · Arrastrar: desplazarse · 1 pallet verde · 2 azul · 3 naranja · 4 rojo</span></div>
@if(rows.Count==0){<div class="alert info no-print">La base de datos no contiene inventario para mostrar. El croquis aparecerá cuando se registre o incorpore inventario.</div>}
<div class="croquis-workspace no-print"><aside><h2>Inventario general consolidado</h2><input class="search" placeholder="Buscar producto o ubicación" @bind="search" @bind:event="oninput" /><div class="table-wrap"><table><thead><tr><th>Producto</th><th>Medida</th><th>Ubicaciones</th><th>Pallets</th><th>Cajas/pallet</th><th>Total cajas</th>@if(Session.CanEdit){<th></th>}</tr></thead><tbody>@foreach(var item in FilteredSummary){<tr><td>@item.Product</td><td>@item.Measure</td><td>@item.Locations</td><td>@item.Pallets</td><td>@item.BoxesPerPallet</td><td>@item.Boxes.ToString("N0")</td>@if(Session.CanEdit){<td>@if(item.Pallets==0&&item.Boxes==0){<button class="danger small" @onclick="()=>DeleteProduct(item)">Eliminar</button>}</td>}</tr>}</tbody></table></div></aside><main><div class="map-part-title">CROQUIS · PARTE @mapPart</div><WarehouseMap Items="rows" Sections="ABCD" OnlyLocation="@onlyLocation" Part="mapPart" Zoom="zoom" ZoomChanged="SetZoom" /></main></div>
<div class="print-only"><div class="print-page cover-table"><h1>CROQUIS NACO · CUADRO DE PRODUCTOS</h1><div class="table-wrap"><table><thead><tr><th>Producto</th><th>Medida</th><th>Ubicaciones</th><th>Pallets</th><th>Cajas/pallet</th><th>Total cajas</th></tr></thead><tbody>@foreach(var item in Summary){<tr><td>@item.Product</td><td>@item.Measure</td><td>@item.Locations</td><td>@item.Pallets</td><td>@item.BoxesPerPallet</td><td>@item.Boxes.ToString("N0")</td></tr>}</tbody></table></div></div><div class="print-page map-print-page"><h1>CROQUIS NACO · PARTE 1</h1><WarehouseMap Items="rows" Sections="ABCD" OnlyLocation="@onlyLocation" Part="1" /></div><div class="print-page map-print-page"><h1>CROQUIS NACO · PARTE 2</h1><WarehouseMap Items="rows" Sections="ABCD" OnlyLocation="@onlyLocation" Part="2" /></div></div>}
@if(!string.IsNullOrWhiteSpace(error)){<div class="alert error no-print">@error</div>}

@code{
 private List<InventoryItem> rows=[];private bool busy;private string error="",search="",locationText="",onlyLocation="";private double zoom=1;private int mapPart=1;
 private List<ProductMapSummary> Summary=>rows.Where(x=>!string.IsNullOrWhiteSpace(x.Producto)).GroupBy(x=>new{Producto=x.Producto.Trim().ToUpperInvariant(),Medida=x.Medida.Trim().ToUpperInvariant()}).OrderBy(g=>g.Key.Producto).ThenBy(g=>g.Key.Medida).Select(g=>new ProductMapSummary{Product=g.First().Producto,Measure=g.First().Medida,Locations=string.Join(", ",g.Select(x=>x.Ubicacion).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(LocationKey)),Pallets=g.Sum(x=>x.Pallets),BoxesPerPallet=string.Join(" / ",g.Select(x=>x.CajasPorPallet).Where(x=>x>0).Distinct().Order()),Boxes=g.Sum(x=>x.Cajas)}).ToList();
 private IEnumerable<ProductMapSummary> FilteredSummary=>Summary.Where(x=>string.IsNullOrWhiteSpace(search)||(x.Product+" "+x.Measure+" "+x.Locations).Contains(search,StringComparison.OrdinalIgnoreCase));
 protected override async Task OnInitializedAsync(){if(Session.IsAuthenticated)await Load();}private async Task Load(){busy=true;error="";try{rows=await Db.GetInventoryAsync(true,true);}catch(Exception ex){error=ex.Message;}finally{busy=false;}}
 private void ApplyLocation(){var value=locationText.Trim().ToUpperInvariant();if(System.Text.RegularExpressions.Regex.IsMatch(value,"^[A-D][1-9][0-9]*$")){onlyLocation=value;error="";}else error="Indique una ubicación válida, por ejemplo A1.";}
 private void ShowAll(){onlyLocation=locationText="";error="";}private void ZoomIn()=>zoom=Math.Min(2.5,zoom*1.2);private void ZoomOut()=>zoom=Math.Max(.35,zoom/1.2);private void ResetZoom()=>zoom=1;private void SetZoom(double value)=>zoom=value;private async Task Print()=>await JS.InvokeVoidAsync("print");private async Task DeleteProduct(ProductMapSummary item){try{await Db.DeleteEmptyProductAsync(item.Product,item.Measure);await Load();}catch(Exception ex){error=ex.Message;}}
 private static string LocationKey(string code){var prefix=new string(code.TakeWhile(c=>!char.IsDigit(c)).ToArray());return int.TryParse(new string(code.SkipWhile(c=>!char.IsDigit(c)).ToArray()),out var number)?prefix+number.ToString("D10"):code;}
 private sealed class ProductMapSummary{public string Product{get;set;}="";public string Measure{get;set;}="";public string Locations{get;set;}="";public long Pallets{get;set;}public string BoxesPerPallet{get;set;}="";public long Boxes{get;set;}}
}

