@page "/catalogo"
@inject NacoDatabase Db
@inject SessionState Session
<div class="page-title"><div><h1>Catálogo de productos</h1><p>Corrija nombres y elimine registros sin existencia.</p></div><button class="secondary" @onclick="Load">Actualizar</button></div>
@if(!Session.IsAuthenticated){<div class="alert error">Inicie sesión para consultar el catálogo.</div>}else{
@if(!Session.CanEdit){<div class="alert info">Acceso de consulta: puede buscar y revisar el catálogo.</div>}
<input class="search" placeholder="Buscar producto o medida" @bind="search" @bind:event="oninput" />
<div class="table-wrap"><table><thead><tr><th>Producto</th><th>Medida</th><th>Pallets</th><th>Cajas</th>@if(Session.CanEdit){<th>Acciones</th>}</tr></thead><tbody>@foreach(var row in Filtered){<tr><td>@row.Producto</td><td>@row.Medida</td><td>@row.Pallets</td><td>@row.Cajas</td>@if(Session.CanEdit){<td><button class="secondary small" @onclick="()=>Edit(row)">Corregir</button> @if(row.Pallets==0&&row.Cajas==0){<button class="danger small" @onclick="()=>Delete(row)">Eliminar</button>}</td>}</tr>}</tbody></table></div>
@if(selected is not null){<div class="form-card catalog-editor"><h2>Corregir @selected.Producto</h2><div class="form-grid"><label>Nombre correcto<input @bind="newProduct" /></label><label>Medida correcta<input @bind="newMeasure" /></label></div><button class="primary" @onclick="Save">Guardar corrección</button> <button class="secondary" @onclick="Cancel">Cancelar</button></div>}}
@if(!string.IsNullOrWhiteSpace(message)){<div class="alert @messageClass">@message</div>}
@code{private List<ProductSummary> rows=[];private ProductSummary? selected;private string search="",newProduct="",newMeasure="",message="",messageClass="error";private IEnumerable<ProductSummary> Filtered=>rows.Where(x=>string.IsNullOrWhiteSpace(search)||(x.Producto+" "+x.Medida).Contains(search,StringComparison.OrdinalIgnoreCase));protected override async Task OnInitializedAsync(){if(Session.IsAuthenticated)await Load();}private async Task Load(){try{rows=await Db.GetCatalogAsync();}catch(Exception ex){Fail(ex.Message);}}private void Edit(ProductSummary row){selected=row;newProduct=row.Producto;newMeasure=row.Medida;}private void Cancel()=>selected=null;private async Task Save(){if(selected is null)return;try{await Db.RenameProductAsync(selected.Producto,selected.Medida,newProduct,newMeasure);selected=null;Success("Producto corregido.");await Load();}catch(Exception ex){Fail(ex.Message);}}private async Task Delete(ProductSummary row){try{await Db.DeleteEmptyProductAsync(row.Producto,row.Medida);Success("Producto sin existencia eliminado.");await Load();}catch(Exception ex){Fail(ex.Message);}}private void Success(string text){message=text;messageClass="success";}private void Fail(string text){message=text;messageClass="error";}}
