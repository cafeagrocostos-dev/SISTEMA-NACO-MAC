@page "/inventario-fisico"
@inject NacoDatabase Db
@inject SessionState Session
@inject IJSRuntime JS

<div class="page-title no-print"><div><h1>Inventario físico</h1><p>@reference · Conteo total por producto, medida y ubicación</p></div><div><button class="secondary" @onclick="NewCount">Nuevo</button> <button class="secondary" @onclick="Load">Actualizar</button></div></div>
@if(!Session.IsAuthenticated){<div class="alert error">Inicie sesión.</div>}else{
<div class="form-card no-print"><div class="form-grid"><label>Fecha del conteo<input type="datetime-local" @bind="countDate" disabled="@saved" /></label><label>Quién hizo el conteo<input @bind="madeBy" disabled="@saved" /></label><label>Quién autoriza<input @bind="authorizedBy" disabled="@saved" /></label><label>Observación<textarea @bind="notes" disabled="@saved"></textarea></label></div></div>

@if(Session.CanEdit&&!saved){<div class="form-card no-print"><h2>Captura del conteo</h2><div class="form-grid physical-editor">
<label>Ubicación<input list="physical-locations" value="@location" @oninput="LocationInput" /></label><datalist id="physical-locations">@foreach(var x in stock.Select(x=>x.Ubicacion).Distinct()){<option value="@x"></option>}</datalist>
<label class="span-2">Producto<input list="physical-products" value="@product" @oninput="ProductInput" /></label><datalist id="physical-products">@foreach(var x in stock){<option value="@x.Producto">@x.Medida · @x.Ubicacion</option>}</datalist>
<label>Medida<input @bind="measure" /></label><label>Pallets<input type="number" min="0" @bind="pallets" @bind:event="oninput" /></label><label>Cajas por pallet<input type="number" min="0" @bind="boxesPerPallet" @bind:event="oninput" /></label><label>Cajas sueltas<input type="number" min="0" @bind="looseBoxes" @bind:event="oninput" /></label><label>Distribución<input placeholder="Ej. 2,2,1" @bind="distribution" @bind:event="oninput" /></label><div class="total-box"><span>Total cajas</span><strong>@Counted.ToString("N0")</strong></div></div>
<div class="distribution-status @(DistributionComplete?"complete":"pending")"><div><span>Pallets contados</span><b>@pallets</b></div><div><span>Distribuidos</span><b>@Distributed</b></div><div><span>Pendientes</span><b>@Pending</b></div><strong>@DistributionMessage</strong></div>
<button class="primary" @onclick="AddOrUpdate">@(editingIndex>=0?"MODIFICAR":"AGREGAR")</button>@if(editingIndex>=0){<button class="secondary" @onclick="ClearEditor">Cancelar</button>}</div>}

<div class="form-card"><div class="filter-row no-print"><label>Mostrar<select @bind="filter"><option>GENERAL</option><option>FALTANTES</option><option>SOBRANTES</option><option>IGUALES</option><option>PENDIENTES</option></select></label><div class="physical-summary">Productos: @Filtered.Count() / @counts.Count · Faltantes: @counts.Count(x=>x.Estado=="FALTANTE") · Sobrantes: @counts.Count(x=>x.Estado=="SOBRANTE") · Iguales: @counts.Count(x=>x.Estado=="IGUAL")</div></div>
<div class="table-wrap"><table><thead><tr><th>Ubicación</th><th>Distribución</th><th>Producto</th><th>Medida</th><th>Pallets</th><th>Cajas/pallet</th><th>Sueltas</th><th>Contado</th><th>Esperado</th><th>Diferencia</th><th>Estado</th>@if(Session.CanEdit&&!saved){<th class="no-print"></th>}</tr></thead><tbody>@foreach(var pair in Filtered.Select((count,index)=>(count,index))){<tr class="status-@pair.count.Estado.ToLowerInvariant()"><td>@pair.count.Item.Ubicacion</td><td>@pair.count.Distribucion</td><td>@pair.count.Item.Producto</td><td>@pair.count.Item.Medida</td><td>@pair.count.PalletsContados</td><td>@pair.count.Item.CajasPorPallet</td><td>@pair.count.CajasSueltas</td><td>@pair.count.Contado.ToString("N0")</td><td>@(pair.count.Esperado?.ToString("N0")??"—")</td><td>@(pair.count.Diferencia?.ToString("N0")??"—")</td><td>@pair.count.Estado</td>@if(Session.CanEdit&&!saved){<td class="no-print"><button class="secondary small" @onclick="()=>Edit(pair.count)">Modificar</button> <button class="danger small" @onclick="()=>Remove(pair.count)">Suprimir</button></td>}</tr>}</tbody></table></div>
<div class="physical-actions no-print">@if(Session.CanEdit&&!saved){<button class="primary" @onclick="Calculate">Calcular</button><button class="success" @onclick="Save" disabled="@(!calculated)">Guardar</button>}@if(Session.CanEdit&&saved&&!incorporated){<button class="danger" @onclick="Incorporate">Incorporar</button>}<button class="secondary" @onclick="ExportCsv">Exportar CSV</button><button class="secondary" @onclick="Print">Imprimir</button></div></div>

<div class="form-card no-print"><h2>Inventarios guardados</h2><div class="filter-row"><label>Desde<input type="date" @bind="savedFrom" /></label><label>Hasta<input type="date" @bind="savedTo" /></label><label>Estado<select @bind="savedStatus"><option>TODOS</option><option>CALCULADO</option><option>INCORPORADO</option></select></label><label>Buscar<input placeholder="Número, usuario o responsable" @bind="savedSearch" @bind:event="oninput" /></label></div><div class="table-wrap"><table><thead><tr><th>N.º</th><th>Fecha</th><th>Usuario</th><th>Estado</th><th>Realizado por</th><th>Autoriza</th><th></th></tr></thead><tbody>@foreach(var item in FilteredSnapshots){<tr><td>IF-@item.IdInventarioFisico.ToString("000000")</td><td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Usuario</td><td>@item.Estado</td><td>@item.QuienHizo</td><td>@item.QuienAutoriza</td><td><button class="secondary small" @onclick="()=>Open(item.IdInventarioFisico)">Abrir</button></td></tr>}</tbody></table></div></div>}
@if(!string.IsNullOrWhiteSpace(message)){<div class="alert @messageClass no-print">@message</div>}

@code{
 private List<InventoryItem> stock=[];private List<PhysicalCount> counts=[];private List<PhysicalSnapshot> snapshots=[];private DateTime countDate=DateTime.Now,savedFrom=DateTime.Today.AddYears(-1),savedTo=DateTime.Today;private long currentId;private bool saved,incorporated,calculated;private int editingIndex=-1;private string reference="NUEVO · SIN GUARDAR",madeBy="",authorizedBy="",notes="",filter="GENERAL",savedStatus="TODOS",savedSearch="",location="",product="",measure="",distribution="",message="",messageClass="error";private long pallets,looseBoxes;private int boxesPerPallet;
 private long Counted=>pallets*boxesPerPallet+looseBoxes;private List<int> Parts=>distribution.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries).Select(x=>int.TryParse(x,out var n)?n:-1).ToList();private int Distributed=>Parts.Where(x=>x>0&&x<=4).Sum();private long Pending=>Math.Max(0,pallets-Distributed);private bool DistributionComplete=>(pallets==0&&string.IsNullOrWhiteSpace(distribution))||(pallets>0&&Parts.Count>0&&Parts.All(x=>x is >=1 and <=4)&&Distributed==pallets);private string DistributionMessage=>Parts.Any(x=>x<1||x>4)?"Use números de 1 a 4 separados por comas.":DistributionComplete?"Distribución completa.":Distributed>pallets?$"Sobran {Distributed-pallets} pallets.":$"Faltan {Pending} pallets por colocar.";
 private IEnumerable<PhysicalCount> Filtered=>filter switch{"FALTANTES"=>counts.Where(x=>x.Estado=="FALTANTE"),"SOBRANTES"=>counts.Where(x=>x.Estado=="SOBRANTE"),"IGUALES"=>counts.Where(x=>x.Estado=="IGUAL"),"PENDIENTES"=>counts.Where(x=>x.Estado=="PENDIENTE"),_=>counts};
 private IEnumerable<PhysicalSnapshot> FilteredSnapshots=>snapshots.Where(x=>x.Fecha.Date>=savedFrom.Date&&x.Fecha.Date<=savedTo.Date&&(savedStatus=="TODOS"||x.Estado==savedStatus)&&(string.IsNullOrWhiteSpace(savedSearch)||("IF-"+x.IdInventarioFisico.ToString("000000")+" "+x.Usuario+" "+x.QuienHizo+" "+x.QuienAutoriza).Contains(savedSearch,StringComparison.OrdinalIgnoreCase)));
 protected override async Task OnInitializedAsync(){if(Session.IsAuthenticated){madeBy=Session.NombreCompleto;await NewCount();}}
 private async Task Load(){try{snapshots=await Db.GetPhysicalSnapshotsAsync();}catch(Exception ex){Fail(ex.Message);}}
 private async Task NewCount(){try{stock=await Db.GetInventoryAsync();counts=[];countDate=DateTime.Now;currentId=0;saved=incorporated=calculated=false;reference="NUEVO · SIN GUARDAR";notes="";authorizedBy="";madeBy=Session.NombreCompleto;ClearEditor();await Load();}catch(Exception ex){Fail(ex.Message);}}
 private void LocationInput(ChangeEventArgs e){location=(Convert.ToString(e.Value)??"").ToUpperInvariant();}
 private void ProductInput(ChangeEventArgs e){product=Convert.ToString(e.Value)??"";var item=stock.FirstOrDefault(x=>x.Producto.Equals(product.Trim(),StringComparison.OrdinalIgnoreCase)&&x.Ubicacion.Equals(location.Trim(),StringComparison.OrdinalIgnoreCase))??stock.FirstOrDefault(x=>x.Producto.Equals(product.Trim(),StringComparison.OrdinalIgnoreCase));if(item is not null){location=item.Ubicacion;measure=item.Medida;boxesPerPallet=item.CajasPorPallet;}}
 private void AddOrUpdate(){location=location.Trim().ToUpperInvariant();if(!System.Text.RegularExpressions.Regex.IsMatch(location,"^[A-D][1-9][0-9]*$")||string.IsNullOrWhiteSpace(product)||product.Length>150||measure.Length>50||pallets<0||boxesPerPallet<0||looseBoxes<0||(pallets>0&&boxesPerPallet==0)||Counted>int.MaxValue){Fail("Revise ubicación, producto y cantidades. El total máximo es 2,147,483,647 cajas.");return;}if(!DistributionComplete){Fail(DistributionMessage);return;}if(counts.Any((x)=>x!=editingItem&&x.Item.Ubicacion.Equals(location,StringComparison.OrdinalIgnoreCase)&&x.Item.Producto.Equals(product.Trim(),StringComparison.OrdinalIgnoreCase)&&x.Item.Medida.Equals(measure.Trim(),StringComparison.OrdinalIgnoreCase))){Fail("Ese producto, medida y ubicación ya están incluidos.");return;}var value=new PhysicalCount{Item=new(){Ubicacion=location,Producto=product.Trim(),Medida=measure.Trim(),CajasPorPallet=boxesPerPallet},PalletsContados=pallets,CajasSueltas=looseBoxes,Distribucion=distribution.Trim()};if(editingIndex>=0)counts[editingIndex]=value;else counts.Add(value);calculated=false;ClearEditor();}
 private PhysicalCount? editingItem=>editingIndex>=0&&editingIndex<counts.Count?counts[editingIndex]:null;
 private void Edit(PhysicalCount item){editingIndex=counts.IndexOf(item);location=item.Item.Ubicacion;product=item.Item.Producto;measure=item.Item.Medida;pallets=item.PalletsContados;boxesPerPallet=item.Item.CajasPorPallet;looseBoxes=item.CajasSueltas;distribution=item.Distribucion;}
 private void Remove(PhysicalCount item){counts.Remove(item);calculated=false;ClearEditor();}
 private void ClearEditor(){editingIndex=-1;location=product=measure=distribution="";pallets=looseBoxes=0;boxesPerPallet=0;}
 private async Task Calculate(){if(counts.Count==0){Fail("Agregue al menos un conteo.");return;}try{stock=await Db.GetInventoryAsync();foreach(var count in counts){count.Esperado=stock.Where(x=>x.Ubicacion.Equals(count.Item.Ubicacion,StringComparison.OrdinalIgnoreCase)&&x.Producto.Equals(count.Item.Producto,StringComparison.OrdinalIgnoreCase)&&x.Medida.Equals(count.Item.Medida,StringComparison.OrdinalIgnoreCase)).Sum(x=>x.Cajas);}calculated=true;Success($"Stock comparado al {DateTime.Now:dd/MM/yyyy HH:mm:ss}. Diferencia = contado − esperado.");}catch(Exception ex){Fail(ex.Message);}}
 private async Task Save(){try{currentId=await Db.SavePhysicalInventoryAsync(countDate,madeBy,authorizedBy,notes,counts);saved=true;reference=$"IF-{currentId:000000}";Success("Inventario físico calculado y guardado.");await Load();}catch(Exception ex){Fail(ex.Message);}}
 private async Task Open(long id){try{var document=await Db.GetPhysicalInventoryAsync(id);currentId=id;counts=document.Counts;notes=document.Notes;countDate=document.Header.Fecha;madeBy=document.Header.QuienHizo;authorizedBy=document.Header.QuienAutoriza;saved=calculated=true;incorporated=document.Header.Estado=="INCORPORADO";reference=$"IF-{id:000000} · {document.Header.Estado}";}catch(Exception ex){Fail(ex.Message);}}
 private async Task Incorporate(){try{await Db.IncorporatePhysicalInventoryAsync(currentId);incorporated=true;reference=$"IF-{currentId:000000} · INCORPORADO";Success("Inventario físico incorporado al stock.");await Load();}catch(Exception ex){Fail(ex.Message);}}
 private async Task ExportCsv(){if(!counts.Any()){Fail("No hay registros para exportar.");return;}var csv=new System.Text.StringBuilder("Ubicacion,Distribucion,Producto,Medida,Pallets,CajasPorPallet,CajasSueltas,Contado,Esperado,Diferencia,Estado\r\n");foreach(var x in Filtered)csv.AppendLine(string.Join(',',new[]{Csv(x.Item.Ubicacion),Csv(x.Distribucion),Csv(x.Item.Producto),Csv(x.Item.Medida),x.PalletsContados.ToString(),x.Item.CajasPorPallet.ToString(),x.CajasSueltas.ToString(),x.Contado.ToString(),x.Esperado?.ToString()??"",x.Diferencia?.ToString()??"",Csv(x.Estado)}));await JS.InvokeVoidAsync("downloadText",$"InventarioFisico_{countDate:yyyyMMdd}.csv",csv.ToString());}
 private static string Csv(string value)=>"\""+value.Replace("\"","\"\"")+"\"";private async Task Print()=>await JS.InvokeVoidAsync("print");private void Success(string text){message=text;messageClass="success";}private void Fail(string text){message=text;messageClass="error";}
}
