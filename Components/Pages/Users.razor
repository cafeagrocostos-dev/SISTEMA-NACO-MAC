@page "/usuarios"
@inject NacoDatabase Db
@inject SessionState Session
<div class="page-title"><div><h1>Usuarios</h1><p>Administración de accesos</p></div><button class="secondary" @onclick="Load">Actualizar</button></div>
@if(!Session.IsAdmin){<div class="alert error">Solo un administrador puede gestionar usuarios.</div>}else{
<div class="form-card"><div class="form-grid"><label>Usuario<input @bind="user" /></label><label>Nombre completo<input @bind="name" /></label><label>Rol<select @bind="role"><option>OPERADOR</option><option>CONSULTA</option><option>ADMIN</option></select></label><label>Contraseña<input type="password" @bind="password" /></label></div><button class="primary" @onclick="Create">Crear usuario</button></div>
<div class="table-wrap"><table><thead><tr><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var x in rows){<tr><td>@x.Usuario</td><td>@x.NombreCompleto</td><td>@x.Rol</td><td>@(x.Activo?"Activo":"Inactivo")</td><td><button class="secondary small" @onclick="()=>SelectPassword(x)">Cambiar clave</button> <button class="danger small" @onclick="()=>Toggle(x)">@(x.Activo?"Desactivar":"Activar")</button></td></tr>}</tbody></table></div>
@if(selected is not null){<div class="form-card catalog-editor"><h2>Nueva contraseña para @selected.Usuario</h2><label>Contraseña<input type="password" @bind="newPassword" /></label><button class="primary" @onclick="SavePassword">Guardar contraseña</button> <button class="secondary" @onclick="()=>selected=null">Cancelar</button></div>}}
@if(!string.IsNullOrWhiteSpace(message)){<div class="alert @messageClass">@message</div>}
@code{private List<UserRow> rows=[];private UserRow? selected;private string user="",name="",role="OPERADOR",password="",newPassword="",message="",messageClass="error";protected override async Task OnInitializedAsync(){if(Session.IsAdmin)await Load();}private async Task Load(){try{rows=await Db.GetUsersAsync();}catch(Exception ex){Fail(ex.Message);}}private async Task Create(){try{await Db.SaveUserAsync(user,name,role,password);user=name=password="";Success("Usuario creado.");await Load();}catch(Exception ex){Fail(ex.Message);}}private void SelectPassword(UserRow row){selected=row;newPassword="";}private async Task SavePassword(){if(selected is null)return;try{await Db.ChangeUserPasswordAsync(selected.IdUsuario,newPassword);selected=null;newPassword="";Success("Contraseña actualizada.");}catch(Exception ex){Fail(ex.Message);}}private async Task Toggle(UserRow row){try{await Db.ToggleUserAsync(row.IdUsuario);Success("Estado del usuario actualizado.");await Load();}catch(Exception ex){Fail(ex.Message);}}private void Success(string text){message=text;messageClass="success";}private void Fail(string text){message=text;messageClass="error";}}
